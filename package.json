{
  "name": "wallet-web",
  "version": "0.1.0",
  "description": "Render Apple Wallet and Google Wallet event tickets in the browser, with React components",
  "keywords": [
    "apple-wallet",
    "google-wallet",
    "pkpass",
    "passkit",
    "wallet",
    "event-ticket",
    "react"
  ],
  "author": "Dmitry Dyomin",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/wallet-web.js",
  "module": "./dist/wallet-web.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wallet-web.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build-storybook": "storybook build -o storybook-static",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "bwip-js": "^4.11.4",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@storybook/html-vite": "^10.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
